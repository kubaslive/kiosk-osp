{
  "name": "frontend",
  "private": true,
  "version": "1.0.6",
  "author": "Jakub Martyka <jmartyka@kiosk.osp.pl>",
  "description": "System Dowodzenia i Kiosk dla Jednostek OSP",
  "copyright": "Copyright © 2026 OSP",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:start": "cross-env NODE_ENV=development electron .",
    "electron:dev": "concurrently -k \"npm run dev\" \"npm run electron:start\"",
    "build:win": "npm run build && electron-builder --win --x64 && cp \"dist-electron/SWD OSP Kiosk Setup 1.0.6.exe\" ~/Desktop/Kiosk_OSP/ || true",
    "deploy-update": "npm run build && electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "firebase": "^12.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.st-osp.kiosk",
    "productName": "SWD OSP Kiosk",
    "directories": {
      "output": "dist-electron"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kubaslive",
        "repo": "kiosk-osp"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ST-OSP Kiosk",
      "uninstallDisplayName": "ST-OSP Kiosk"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/logo.png"
    }
  }
}
